             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:uicomponents="clr-namespace:Trials.UIComponents"
             xmlns:local="clr-namespace:Trials"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="ThemeTextColor">White</Color>
        <Color x:Key="ThemeBackgroundColor">#3d5174</Color>
        <Color x:Key="ThemeForegroundColor">#333e52</Color>
        <Color x:Key="ThemeAccentColor">#8c31b0</Color>
        
