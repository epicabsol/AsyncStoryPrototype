        <SolidColorBrush x:Key="ThemeForeground" Color="{StaticResource ThemeForegroundColor}" />
        <SolidColorBrush x:Key="ThemeAccent" Color="{StaticResource ThemeAccentColor}" />

        <sys:Double x:Key="GutterSize">10</sys:Double>
        <sys:Double x:Key="DisabledOpacity">0.3</sys:Double>

        <DropShadowEffect x:Key="TitleDropShadow" BlurRadius="5" ShadowDepth="0" Direction="0" Opacity="1.0" Color="{StaticResource ThemeBackgroundColor}" />

