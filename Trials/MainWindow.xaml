                </Button>
            </Grid>
        </Grid>
        
        <!-- Center Column -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <TextBlock Text="Hello There!" />
            
            <!-- Button Grid -->
            <Grid Grid.Row="1" Margin="-10 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48px" />
                    <RowDefinition Height="48px" />
                    <RowDefinition Height="48px" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="10 10 0 0" />
                    </Style>
                </Grid.Resources>

                <Button>Talk</Button>
                <Button Grid.Column="1" IsEnabled="False">Locked</Button>
                <Button Grid.Column="2" IsEnabled="False"></Button>
                <Button Grid.Column="3" IsEnabled="False"></Button>
                <Button Grid.Column="4" IsEnabled="False"></Button>

                <Button Grid.Row="1" IsEnabled="False"></Button>
                <Button Grid.Row="1" Grid.Column="1" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="1" Grid.Column="2" IsEnabled="False"></Button>
                <Button Grid.Row="1" Grid.Column="3" IsEnabled="False"></Button>
                <Button Grid.Row="1" Grid.Column="4" IsEnabled="False"></Button>

                <Button Grid.Row="2" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="2" Grid.Column="1" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="2" Grid.Column="2" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="2" Grid.Column="3" IsEnabled="False"></Button>
                <Button Grid.Row="2" Grid.Column="4" IsEnabled="True">Back</Button>
            </Grid>
        </Grid>
        
        <!-- Right Column -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Right Panel -->
            <Border Background="{StaticResource ThemeForeground}">
                
            </Border>

            <!-- Button Pagination Controls -->
            <Grid Grid.Row="1" Margin="0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

