<Window x:Class="Trials.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uicomponents="clr-namespace:Trials.UIComponents"
        xmlns:local="clr-namespace:Trials"
        mc:Ignorable="d"
        Title="MainWindow" Height="561.562" Width="935">
    <Grid Background="{StaticResource ThemeBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Info Header -->
            <Border Background="{StaticResource ThemeForeground}" Padding="0 5 10 0">
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200px" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource ThemeAccent}" Margin="0 0 0 5" Padding="5 0">
                        <Grid>
                            <TextBlock Text="THE&#x0a;PAST" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Bottom" FontSize="48" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource ThemeAccent}" Margin="0 0 0 5" Padding="5 0">
                        <TextBlock Text="PLANET: TERRA" TextAlignment="Right" />
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource ThemeAccent}" Margin="0 0 0 5" Padding="5 0">
                        <TextBlock Text="SYSTEM: SOL" TextAlignment="Right" />
                    </Border>
                </Grid>
            </Border>
        
            <!-- Left Content (Map, Enemy Combatants...) -->
            <Border Grid.Row="1" Background="{StaticResource ThemeForeground}" />
            
            <!-- System Controls (Menu, SaveLoad, LevelUp, Appearance...) -->
            <Border Grid.Row="2" Background="{StaticResource ThemeForeground}">
                <uicomponents:ControlMenuBlock />
            </Border>
            
            <!-- Text Pagination Controls -->
            <Grid Grid.Row="3" Margin="0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

