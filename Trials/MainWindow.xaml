<Window x:Class="Trials.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uicomponents="clr-namespace:Trials.UIComponents"
        xmlns:local="clr-namespace:Trials"
        mc:Ignorable="d"
        Title="MainWindow" Height="561.562" Width="935">
    <Grid Background="{StaticResource ThemeBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Info Header -->
            <Border Background="{StaticResource ThemeForeground}" Padding="0 5 10 0">
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200px" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource ThemeAccent}" Margin="0 0 0 5" Padding="5 0">
                        <Grid>
                            <TextBlock Text="THE&#x0a;PAST" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Bottom" FontSize="48" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource ThemeAccent}" Margin="0 0 0 5" Padding="5 0">
                        <TextBlock Text="PLANET: TERRA" TextAlignment="Right" />
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource ThemeAccent}" Margin="0 0 0 5" Padding="5 0">
                        <TextBlock Text="SYSTEM: SOL" TextAlignment="Right" />
                    </Border>
                </Grid>
            </Border>
        
            <!-- Left Content (Map, Enemy Combatants...) -->
            <Border Grid.Row="1" Background="{StaticResource ThemeForeground}" />
            
            <!-- System Controls (Menu, SaveLoad, LevelUp, Appearance...) -->
            <Border Grid.Row="2" Background="{StaticResource ThemeForeground}">
                <uicomponents:ControlMenuBlock />
            </Border>
            
            <!-- Text Pagination Controls -->
            <Grid Grid.Row="3" Margin="0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <uicomponents:PathButton Margin="10 0 0 0" Padding="7 10" PathData="{StaticResource TextPreviousGlyph}" />

                <uicomponents:PathButton Grid.Column="1" Margin="10 0 0 0" Padding="7 10" IsEnabled="False" PathData="{StaticResource TextNextGlyph}" />
            </Grid>
        </Grid>
        
        <!-- Center Column -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <TextBlock Text="Hello There!" />
            
            <!-- Button Grid -->
            <Grid Grid.Row="1" Margin="-10 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48px" />
                    <RowDefinition Height="48px" />
                    <RowDefinition Height="48px" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="10 10 0 0" />
                    </Style>
                </Grid.Resources>

                <Button>Talk</Button>
                <Button Grid.Column="1" IsEnabled="False">Locked</Button>
                <Button Grid.Column="2" IsEnabled="False"></Button>
                <Button Grid.Column="3" IsEnabled="False"></Button>
                <Button Grid.Column="4" IsEnabled="False"></Button>

                <Button Grid.Row="1" IsEnabled="False"></Button>
                <Button Grid.Row="1" Grid.Column="1" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="1" Grid.Column="2" IsEnabled="False"></Button>
                <Button Grid.Row="1" Grid.Column="3" IsEnabled="False"></Button>
                <Button Grid.Row="1" Grid.Column="4" IsEnabled="False"></Button>

                <Button Grid.Row="2" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="2" Grid.Column="1" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="2" Grid.Column="2" IsEnabled="False" Background="{StaticResource ThemeAccent}"></Button>
                <Button Grid.Row="2" Grid.Column="3" IsEnabled="False"></Button>
                <Button Grid.Row="2" Grid.Column="4" IsEnabled="True">Back</Button>
            </Grid>
        </Grid>
        
        <!-- Right Column -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Right Panel -->
            <Border Background="{StaticResource ThemeForeground}">
                
            </Border>

            <!-- Button Pagination Controls -->
            <Grid Grid.Row="1" Margin="0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <uicomponents:PathButton Margin="0 0 10 0" Padding="15 9" IsEnabled="False" PathData="{StaticResource ButtonsPreviousGlyph}" />

                <uicomponents:PathButton Grid.Column="1" Margin="0 0 10 0" Padding="15 9" IsEnabled="True" PathData="{StaticResource ButtonsNextGlyph}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
