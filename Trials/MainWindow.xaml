                </Button>

                <Button Grid.Column="1" Margin="0 0 10 0" Padding="15 9" IsEnabled="True">
                    <Path Fill="{StaticResource ThemeBackground}" Data="m 42.0164 11.00022 h -17 c -1.104 0 -2 0.896 -2 2 v 5 c 0 1.104 0.896 2 2 2 h 17 c 1.104 0 2 -0.896 2 -2 v -5 c 0 -1.104 -0.896 -2 -2 -2 z m 4 -11 v 5.999 l 3 3.999 -3 4.008 v 5.994 l 8 -10 z m 8 0 v 5.999 l 3 3.999 -3 4.008 v 5.994 l 8 -10 z m -12 0 h -17 c -1.104 0 -2 0.896 -2 2 v 5 c 0 1.104 0.896 2 2 2 h 17 c 1.104 0 2 -0.896 2 -2 v -5 c 0 -1.104 -0.896 -2 -2 -2 z m -23 11 h -17 c -1.104 0 -2 0.896 -2 2 v 5 c 0 1.104 0.896 2 2 2 h 17 c 1.104 0 2 -0.896 2 -2 v -5 c 0 -1.104 -0.896 -2 -2 -2 z m 0 -11 h -17 c -1.104 0 -2 0.896 -2 2 v 5 c 0 1.104 0.896 2 2 2 h 17 c 1.104 0 2 -0.896 2 -2 v -5 c 0 -1.104 -0.896 -2 -2 -2 z" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
