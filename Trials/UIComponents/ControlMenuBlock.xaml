<UserControl x:Class="Trials.UIComponents.ControlMenuBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:uicomponents="clr-namespace:Trials.UIComponents"
             mc:Ignorable="d">
    <Grid Margin="10 5">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Style TargetType="uicomponents:PathButton" BasedOn="{StaticResource {x:Type uicomponents:PathButton}}">
                <Setter Property="Margin" Value="1" />
                <Setter Property="Width" Value="34px" />
                <Setter Property="Height" Value="34px" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{StaticResource ThemeBackground}" />
                <Setter Property="PathFill" Value="{StaticResource ThemeText}" />
            </Style>
        </Grid.Resources>

        <!-- Main Menu Button -->
        <uicomponents:PathButton PathData="{StaticResource MainMenuGlyph}" />
        <!-- Save/Load Button -->
        <uicomponents:PathButton Grid.Column="1" PathScale="1.2" PathData="{StaticResource SaveLoadGlyph}" />
        <!-- Quicksave Button -->
        <uicomponents:PathButton Grid.Column="2" IsEnabled="False" PathScale="1.1" PathData="{StaticResource QuicksaveGlyph}" />
        <!-- Appearance Button -->
        <uicomponents:PathButton Grid.Column="3" Grid.RowSpan="2" Width="70px" Height="70px" PathScale="2.5" PathData="{StaticResource AppearanceGlyph}" />
        <!-- Messenger Button -->
        <uicomponents:PathButton Grid.Row="1" Grid.Column="0" IsEnabled="False" PathData="{StaticResource MessengerGlyph}" />
        <!-- Perks Button -->
        <uicomponents:PathButton Grid.Row="1" Grid.Column="1" IsEnabled="False" PathData="{StaticResource PerksGlyph}" />
        <!-- Level Up Button -->
        <uicomponents:PathButton Grid.Row="1" Grid.Column="2" IsEnabled="False" PathData="{StaticResource LevelUpGlyph}" />
    </Grid>
</UserControl>
